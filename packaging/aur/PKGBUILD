# Maintainer: Chase Brower <chasebrowerpersonal@gmail.com>
pkgname=fermata-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Music player for your own library, with mixes, radio, lyrics and playlists"
arch=('x86_64')
url="https://github.com/camelCase12/fermata"
license=('MIT')
depends=('mpv' 'fontconfig' 'freetype2' 'libx11' 'libxcursor' 'libxext' 'libxfixes' 'libxi' 'libxrandr' 'libice' 'libsm' 'libglvnd' 'dbus')
provides=('fermata')
conflicts=('fermata')
options=('!strip' '!debug')
source=("$url/releases/download/v$pkgver/fermata-$pkgver-linux-x64.tar.gz")
sha256sums=('FILL_IN_FROM_THE_RELEASE')

package() {
    cd "fermata-$pkgver-linux-x64"
    local id=io.github.camelcase12.Fermata
    install -Dm755 fermata libSkiaSharp.so libHarfBuzzSharp.so -t "$pkgdir/usr/lib/fermata/"
    install -dm755 "$pkgdir/usr/bin"
    ln -s /usr/lib/fermata/fermata "$pkgdir/usr/bin/fermata"
    install -Dm644 "packaging/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
    install -Dm644 "packaging/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
    install -Dm644 icons/fermata.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$id.svg"
    for size in 32 48 64 128 256; do
        install -Dm644 "icons/fermata-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$id.png"
    done
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
    install -Dm644 THIRD-PARTY-NOTICES.md licenses/* -t "$pkgdir/usr/share/licenses/$pkgname/"
}
