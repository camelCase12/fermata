<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fermata.ViewModels"
             xmlns:controls="using:Fermata.Controls"
             xmlns:playback="using:Fermata.Playback"
             x:Class="Fermata.Views.PlayerBar"
             x:DataType="vm:PlayerViewModel">
  <UserControl.Styles>
    <Style Selector="Button.play">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLipBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.play:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLipBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource SidebarBrush}">
    <Grid RowDefinitions="18,*" Height="92">
      <!-- Progress along the top of the bar -->
      <controls:SeekBar Name="Progress" AutomationProperties.Name="Position" Value="{Binding Progress}" Thickness="2" Height="18"
                        TrackBrush="{DynamicResource DividerBrush}" FillBrush="{DynamicResource AccentBrush}"
                        AlwaysShowHandle="{Binding HasTrack}" IsEnabled="{Binding HasTrack}" />
      <Canvas Name="HoverLayer" IsHitTestVisible="False" ClipToBounds="False">
        <Border Name="HoverBubble" IsVisible="False" Background="{DynamicResource PopupBrush}" CornerRadius="6" Padding="7,3" Canvas.Top="-30">
          <TextBlock Name="HoverText" FontSize="12" FontWeight="SemiBold" />
        </Border>
      </Canvas>

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="14,0,18,4">
        <!-- Current track -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding ShowsTrack}">
          <Button Theme="{StaticResource LinkButton}" Command="{Binding ToggleNowPlayingCommand}" ToolTip.Tip="Now playing (Q)">
            <controls:CoverArt Source="{Binding Art}" PlaceholderKey="{Binding Title}" Width="50" Height="50" Radius="6" />
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,6,0" Spacing="2">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
            <controls:InlineRow>
              <Button Theme="{StaticResource LinkButton}" Command="{Binding OpenArtistCommand}">
                <TextBlock Text="{Binding Artist}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="220" />
              </Button>
              <TextBlock Text=" · " FontSize="12.5" Classes="tertiary" IsVisible="{Binding Details, Converter={x:Static vm:Formats.NotEmpty}}" />
              <Button Theme="{StaticResource LinkButton}" Command="{Binding OpenAlbumCommand}">
                <TextBlock Text="{Binding Details}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="220" />
              </Button>
            </controls:InlineRow>
          </StackPanel>
          <ToggleButton Grid.Column="2" Theme="{StaticResource IconToggle}" IsChecked="{Binding IsLiked, Mode=OneWay}"
                        Command="{Binding ToggleLikeCommand}" ToolTip.Tip="Like (F)">
            <Panel>
              <PathIcon Data="{StaticResource Icon.HeartOutline}" IsVisible="{Binding !IsLiked}" />
              <PathIcon Data="{StaticResource Icon.Heart}" IsVisible="{Binding IsLiked}" />
            </Panel>
          </ToggleButton>
        </Grid>
        <TextBlock Classes="tertiary" VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding EngineMissing}"
                   Text="{Binding EngineMessage}" TextWrapping="Wrap" MaxWidth="360" />

        <!-- Transport -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="24,0">
          <ToggleButton Theme="{StaticResource IconToggle}" Classes="mode" IsChecked="{Binding Shuffle, Mode=OneWay}"
                        Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="Shuffle (S)">
            <PathIcon Data="{StaticResource Icon.Shuffle}" Classes="small" />
          </ToggleButton>
          <Button Theme="{StaticResource IconButton}" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous (Ctrl+←)"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <PathIcon Data="{StaticResource Icon.Previous}" />
          </Button>
          <Button Classes="play" Theme="{StaticResource IconButton}" Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play or pause (Space)">
            <Panel>
              <PathIcon Data="{StaticResource Icon.Play}" Width="26" Height="26" IsVisible="{Binding !IsPlaying}" />
              <PathIcon Data="{StaticResource Icon.Pause}" Width="26" Height="26" IsVisible="{Binding IsPlaying}" />
            </Panel>
          </Button>
          <Button Theme="{StaticResource IconButton}" Command="{Binding NextCommand}" ToolTip.Tip="Next (Ctrl+→)"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <PathIcon Data="{StaticResource Icon.Next}" />
          </Button>
          <ToggleButton Name="RepeatButton" Theme="{StaticResource IconToggle}" Classes="mode" Command="{Binding CycleRepeatCommand}" ToolTip.Tip="Repeat (R)">
            <Panel>
              <PathIcon Name="RepeatIcon" Data="{StaticResource Icon.Repeat}" Classes="small" />
              <PathIcon Name="RepeatOneIcon" Data="{StaticResource Icon.RepeatOne}" Classes="small" IsVisible="False" />
            </Panel>
          </ToggleButton>
        </StackPanel>

        <!-- Time, volume and the queue -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
          <TextBlock VerticalAlignment="Center" Classes="num" Margin="0,0,10,0" IsVisible="{Binding HasTrack}">
            <Run Text="{Binding PositionText}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Run Text=" / " Foreground="{DynamicResource TextTertiaryBrush}" />
            <Run Text="{Binding DurationText}" Foreground="{DynamicResource TextTertiaryBrush}" />
          </TextBlock>
          <Button Name="MuteButton" Theme="{StaticResource IconButton}" Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Mute (M)">
            <PathIcon Name="VolumeIcon" Data="{StaticResource Icon.VolumeHigh}" />
          </Button>
          <controls:SeekBar Name="VolumeBar" AutomationProperties.Name="Volume" Width="90" Height="20" Value="{Binding Volume}" VerticalAlignment="Center"
                            TrackBrush="{DynamicResource DividerBrush}" FillBrush="{DynamicResource TextSecondaryBrush}" Thickness="2" />
          <Button Theme="{StaticResource IconButton}" Command="{Binding ToggleNowPlayingCommand}" ToolTip.Tip="Now playing and queue (Q)"
                  Margin="6,0,0,0">
            <PathIcon Data="{StaticResource Icon.Queue}" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
