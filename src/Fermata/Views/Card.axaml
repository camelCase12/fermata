<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Fermata.Controls"
             xmlns:views="using:Fermata.Views"
             x:Class="Fermata.Views.Card"
             Cursor="Hand" Background="Transparent">
  <UserControl.Styles>
    <Style Selector="views|Card Button#PlayButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(6px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="views|Card:pointerover Button#PlayButton, views|Card Button#PlayButton:focus-visible">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="views|Card:pointerover Border#Shade">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="views|Card Button#PlayButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="10" Margin="0,0,0,6">
    <controls:SquarePanel>
      <controls:CoverArt Name="Art" Radius="10" />
      <Border CornerRadius="10" ClipToBounds="True">
        <controls:Mosaic Name="MosaicArt" IsVisible="False" />
      </Border>
      <Border Name="Shade" Opacity="0" CornerRadius="10" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,40%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="Transparent" />
            <GradientStop Offset="1" Color="{StaticResource ShadeColor}" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Button Name="PlayButton" Theme="{StaticResource IconButton}" Width="40" Height="40" CornerRadius="12"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
              Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentLipBrush}"
              Foreground="{DynamicResource AccentForegroundBrush}" ToolTip.Tip="Play">
        <PathIcon Data="{StaticResource Icon.Play}" Width="26" Height="26" />
      </Button>
    </controls:SquarePanel>
    <StackPanel Spacing="3">
      <TextBlock Name="Title" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
      <TextBlock Name="Subtitle" FontSize="13" Classes="secondary" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </StackPanel>
</UserControl>
