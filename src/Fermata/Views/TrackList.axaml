<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Fermata.ViewModels"
             xmlns:lib="using:Fermata.Library"
             xmlns:views="using:Fermata.Views"
             x:Class="Fermata.Views.TrackList"
             x:DataType="vm:TrackListModel">
  <StackPanel>
    <Grid Name="Header" ColumnDefinitions="52,4*,3*,3*,40,60,40" Margin="8,0,4,8" IsVisible="{Binding ShowHeader}">
      <TextBlock Grid.Column="1" Text="TITLE" Classes="overline" Foreground="{DynamicResource TextTertiaryBrush}" />
      <TextBlock Name="ArtistHeader" Grid.Column="2" Text="ARTIST" Classes="overline" Foreground="{DynamicResource TextTertiaryBrush}" />
      <TextBlock Grid.Column="3" Text="ALBUM" Classes="overline" Foreground="{DynamicResource TextTertiaryBrush}" />
      <PathIcon Grid.Column="5" Data="{StaticResource Icon.History}" Classes="small" HorizontalAlignment="Right" Margin="0,0,12,0"
                Foreground="{DynamicResource TextTertiaryBrush}" />
    </Grid>
    <ListBox Name="List" Classes="rows inline" ItemsSource="{Binding Tracks}" SelectionMode="Multiple">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="lib:Track">
          <views:TrackRow />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</UserControl>
