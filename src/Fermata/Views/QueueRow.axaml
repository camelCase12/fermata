<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:playback="using:Fermata.Playback"
             xmlns:vm="using:Fermata.ViewModels"
             xmlns:views="using:Fermata.Views"
             xmlns:controls="using:Fermata.Controls"
             x:Class="Fermata.Views.QueueRow"
             x:DataType="playback:QueueEntry"
             Background="Transparent">
  <UserControl.Styles>
    <Style Selector="views|QueueRow Button#RemoveButton, views|QueueRow Border#PlayingOverlay, views|QueueRow Border#PlayOverlay">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover views|QueueRow:not(.current) Button#RemoveButton,
                     ListBoxItem:pointerover views|QueueRow:not(.current) Border#PlayOverlay">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:pointerover views|QueueRow TextBlock#Duration">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover views|QueueRow.current TextBlock#Duration">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="views|QueueRow.current TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="views|QueueRow.current Border#PlayingOverlay">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="views|QueueRow.played Border#Row">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="views|QueueRow.current Border#Row">
      <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover views|QueueRow Border#Row">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected views|QueueRow Border#Row">
      <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover views|QueueRow Border#Row">
      <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
    </Style>
    <Style Selector="ListBoxItem.drop views|QueueRow Border#Row">
      <Setter Property="Background" Value="{DynamicResource DropTargetBrush}" />
    </Style>
    <Style Selector="views|QueueRow Border#AutoplayDivider">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|QueueRow.first-autoplay Border#AutoplayDivider">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
  <!-- The divider above the first entry added by autoplay. -->
  <Border Name="AutoplayDivider" DockPanel.Dock="Top" Padding="10,14,10,6">
    <Grid ColumnDefinitions="Auto,*">
      <TextBlock Text="Added by autoplay" Classes="label" VerticalAlignment="Center" />
      <Border Grid.Column="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
    </Grid>
  </Border>
  <Border Name="Row" CornerRadius="10">
  <Grid ColumnDefinitions="46,*,Auto" Margin="6,0" Height="56">
    <Panel Width="42" Height="42">
      <controls:CoverArt Name="Art" Width="42" Height="42" Radius="6" />
      <Border Name="PlayingOverlay" Background="{DynamicResource ShadeStrongBrush}" CornerRadius="6">
        <PathIcon Data="{StaticResource Icon.Equalizer}" Classes="small" Foreground="{DynamicResource AccentBrush}" />
      </Border>
      <Border Name="PlayOverlay" Background="{DynamicResource ShadeBrush}" CornerRadius="6" Cursor="Hand" ToolTip.Tip="Play from here">
        <PathIcon Data="{StaticResource Icon.Play}" Foreground="{DynamicResource OnTintPrimaryBrush}" />
      </Border>
    </Panel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Spacing="2">
      <TextBlock Name="Title" Text="{Binding Track.Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Track.DisplayArtist}" FontSize="12.5" Classes="secondary" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <Panel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0">
      <TextBlock Name="Duration" Text="{Binding Track.Duration, Converter={x:Static vm:Formats.DurationConverter}}"
                 Classes="num" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
      <Button Name="RemoveButton" Theme="{StaticResource IconButton}" Width="30" Height="30" ToolTip.Tip="Remove from queue">
        <PathIcon Data="{StaticResource Icon.Close}" Classes="small" />
      </Button>
    </Panel>
  </Grid>
  </Border>
  </DockPanel>
</UserControl>
