<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Fermata.ViewModels.Pages"
             xmlns:lib="using:Fermata.Library"
             xmlns:views="using:Fermata.Views"
             xmlns:controls="using:Fermata.Controls"
             x:Class="Fermata.Views.Pages.AlbumView"
             x:DataType="pages:AlbumViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,10,32,40" Spacing="30">
      <Grid ColumnDefinitions="Auto,*">
        <controls:CoverArt Source="{Binding Album.Art}" PlaceholderKey="{Binding Album.Key}" Width="200" Height="200" Radius="16" />
        <StackPanel Grid.Column="1" Margin="28,0,0,4" VerticalAlignment="Bottom" Spacing="8">
          <TextBlock Text="{Binding Kind}" Classes="kind" />
          <TextBlock Text="{Binding Album.Title}" Classes="display" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          <ItemsControl ItemsSource="{Binding Artists}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="lib:Artist">
                <Button Theme="{StaticResource LinkButton}" Foreground="{DynamicResource TextPrimaryBrush}"
                        Command="{Binding $parent[UserControl].((pages:AlbumViewModel)DataContext).OpenArtistCommand}" CommandParameter="{Binding}">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Album.Artist}" FontWeight="SemiBold" FontSize="15" IsVisible="{Binding Album.IsCompilation}" />
          <TextBlock Text="{Binding Details}" Classes="secondary" />
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Theme="{StaticResource TextButton}" Classes="accent" Command="{Binding PlayCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Play}" Classes="small" />
                <TextBlock Text="Play" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource TextButton}" Command="{Binding ShuffleCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Shuffle}" Classes="small" />
                <TextBlock Text="Shuffle" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource IconButton}" Command="{Binding AddToQueueCommand}" ToolTip.Tip="Add to queue">
              <PathIcon Data="{StaticResource Icon.PlaylistAdd}" />
            </Button>
            <Button Theme="{StaticResource IconButton}" Command="{Binding RadioCommand}" ToolTip.Tip="Start radio">
              <PathIcon Data="{StaticResource Icon.Radio}" />
            </Button>
            <Button Theme="{StaticResource IconButton}" Command="{Binding ShowFolderCommand}" ToolTip.Tip="Show in folder">
              <PathIcon Data="{StaticResource Icon.Folder}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
      <views:TrackList DataContext="{Binding List}" />
      <views:Shelf Title="{Binding MoreTitle}" Items="{Binding MoreByArtist}"
                   IsVisible="{Binding MoreByArtist.Count, Converter={x:Static views:Converters.Positive}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
