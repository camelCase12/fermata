<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Fermata.ViewModels.Pages"
             xmlns:views="using:Fermata.Views"
             x:Class="Fermata.Views.Pages.GenreView"
             x:DataType="pages:GenreViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,10,32,40" Spacing="30">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding KindLabel}" Classes="overline" />
        <TextBlock Text="{Binding Title}" Classes="display" />
        <TextBlock Text="{Binding Details}" Classes="secondary" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
          <Button Theme="{StaticResource PillButton}" Classes="accent" Command="{Binding ShuffleCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Shuffle}" Classes="small" />
              <TextBlock Text="Shuffle" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Theme="{StaticResource PillButton}" Command="{Binding RadioCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource Icon.Radio}" Classes="small" />
              <TextBlock Text="Radio" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
      <views:Shelf Title="Albums" Items="{Binding Albums}" IsVisible="{Binding Albums.Count, Converter={x:Static views:Converters.Positive}}" />
      <StackPanel Spacing="12">
        <TextBlock Text="Songs" Classes="h2" />
        <views:TrackList DataContext="{Binding List}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
