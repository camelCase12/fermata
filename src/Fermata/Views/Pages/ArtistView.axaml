<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Fermata.ViewModels.Pages"
             xmlns:views="using:Fermata.Views"
             xmlns:controls="using:Fermata.Controls"
             x:Class="Fermata.Views.Pages.ArtistView"
             x:DataType="pages:ArtistViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,10,32,40" Spacing="34">
      <Grid ColumnDefinitions="Auto,*">
        <controls:CoverArt Source="{Binding Artist.Art}" PlaceholderKey="{Binding Artist.Name}" Width="220" Height="220" IsRound="True" />
        <StackPanel Grid.Column="1" Margin="30,0,0,4" VerticalAlignment="Bottom" Spacing="8">
          <TextBlock Text="Artist" Classes="kind" />
          <TextBlock Text="{Binding Artist.Name}" Classes="display" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Details}" Classes="secondary" />
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
            <Button Theme="{StaticResource TextButton}" Classes="accent" Command="{Binding PlayCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Play}" Classes="small" />
                <TextBlock Text="Play" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource TextButton}" Command="{Binding ShuffleCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Shuffle}" Classes="small" />
                <TextBlock Text="Shuffle" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource TextButton}" Command="{Binding RadioCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Radio}" Classes="small" />
                <TextBlock Text="Radio" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="12">
        <TextBlock Text="Songs" Classes="h2" />
        <views:TrackList DataContext="{Binding TopSongs}" />
        <Button Theme="{StaticResource TextButton}" HorizontalAlignment="Left" Command="{Binding ToggleAllSongsCommand}" IsVisible="{Binding HasMoreSongs}">
          <Panel>
            <TextBlock Text="Show all songs" IsVisible="{Binding !ShowAllSongs}" />
            <TextBlock Text="Show fewer" IsVisible="{Binding ShowAllSongs}" />
          </Panel>
        </Button>
      </StackPanel>

      <StackPanel Spacing="14" IsVisible="{Binding Albums.Count, Converter={x:Static views:Converters.Positive}}">
        <TextBlock Text="Albums" Classes="h2" />
        <views:CardGrid Items="{Binding Albums}" />
      </StackPanel>

      <views:Shelf Title="Appears on" Items="{Binding AppearsOn}" IsVisible="{Binding HasAppearances}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
