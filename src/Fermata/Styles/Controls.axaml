<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- A transparent square button for a single icon. -->
      <ControlTheme x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
          <FocusAdornerTemplate>
            <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="12" Margin="-2" AdornerLayer.IsClipEnabled="False" />
          </FocusAdornerTemplate>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="Lip" Background="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}" Margin="0,2,0,0" />
              <Border Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Margin="0,0,0,2">
                <Border.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
                  </Transitions>
                </Border.Transitions>
                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>
        <!-- Hovered, the button shows as a key on a solid lip, and pressing pushes it onto the lip. -->
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource KeyFaceBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource KeyLipBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Face">
          <Setter Property="RenderTransform" Value="translateY(2px)" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.35" />
        </Style>
      </ControlTheme>

      <!-- A two-state icon button, in the accent colour when on. -->
      <ControlTheme x:Key="IconToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FocusAdorner">
          <FocusAdornerTemplate>
            <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="12" Margin="-2" AdornerLayer.IsClipEnabled="False" />
          </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="Lip" Background="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}" Margin="0,2,0,0" />
              <Border Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Margin="0,0,0,2">
                <Border.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
                  </Transitions>
                </Border.Transitions>
                <Panel>
                  <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Name="Dot" Width="4" Height="4" CornerRadius="2" Margin="0,0,0,3" IsVisible="False"
                          HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{TemplateBinding Foreground}" />
                </Panel>
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource KeyFaceBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource KeyLipBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Face">
          <Setter Property="RenderTransform" Value="translateY(2px)" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:checked:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <!-- A playback mode, such as shuffle, shows a dot while it is on. -->
        <Style Selector="^.mode:checked /template/ Border#Dot">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>

      <!-- The frame, shadow and window buttons that Avalonia draws where the compositor leaves decorations
           to the window, as GNOME does on Wayland. There is no title bar: the window's own top row takes its
           place, and the buttons sit at its right end (see MainWindow). The shadow's width is also where the
           edges can be dragged to resize. -->
      <ControlTheme x:Key="WindowDecorations" TargetType="WindowDrawnDecorations">
        <Setter Property="DefaultTitleBarHeight" Value="0" />
        <Setter Property="DefaultFrameThickness" Value="1" />
        <Setter Property="DefaultShadowThickness" Value="12" />
        <Setter Property="Template">
          <WindowDrawnDecorationsTemplate>
            <WindowDrawnDecorationsContent>
              <WindowDrawnDecorationsContent.Underlay>
                <Border Name="Frame" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{TemplateBinding FrameThickness}"
                        IsHitTestVisible="False" />
              </WindowDrawnDecorationsContent.Underlay>
              <WindowDrawnDecorationsContent.Overlay>
                <Panel Name="ShadowInset">
                  <Panel Name="FrameInset">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,16,16,0" IsVisible="{TemplateBinding HasTitleBar}">
                      <StackPanel.Styles>
                        <Style Selector="Button">
                          <Setter Property="Width" Value="32" />
                          <Setter Property="Height" Value="32" />
                          <!-- Clicking a window button leaves keyboard focus where it was. -->
                          <Setter Property="Focusable" Value="False" />
                        </Style>
                        <Style Selector="PathIcon">
                          <Setter Property="Width" Value="18" />
                          <Setter Property="Height" Value="18" />
                        </Style>
                      </StackPanel.Styles>
                      <Button Name="PART_MinimizeButton" Theme="{StaticResource IconButton}"
                              WindowDecorationProperties.ElementRole="MinimizeButton">
                        <PathIcon Data="{DynamicResource Icon.Minimize}" />
                      </Button>
                      <Button Name="PART_MaximizeButton" Theme="{StaticResource IconButton}"
                              WindowDecorationProperties.ElementRole="MaximizeButton">
                        <PathIcon Name="MaximizeIcon" Data="{DynamicResource Icon.Maximize}" />
                      </Button>
                      <Button Name="PART_CloseButton" Theme="{StaticResource IconButton}"
                              WindowDecorationProperties.ElementRole="CloseButton">
                        <PathIcon Data="{DynamicResource Icon.Close}" />
                      </Button>
                    </StackPanel>
                  </Panel>
                </Panel>
              </WindowDrawnDecorationsContent.Overlay>
            </WindowDrawnDecorationsContent>
          </WindowDrawnDecorationsTemplate>
        </Setter>

        <!-- A normal window: rounded corners, a soft shadow and a thin outline. MainWindow rounds its content to
             match, and the background fills the corners between the two. -->
        <Style Selector="^:has-shadow /template/ Border#Frame">
          <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
          <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
          <Setter Property="CornerRadius" Value="10" />
          <Setter Property="BoxShadow" Value="0 2 10 0 #80000000" />
        </Style>
        <Style Selector="^:has-shadow /template/ Panel#ShadowInset">
          <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
        </Style>
        <Style Selector="^:has-border /template/ Panel#FrameInset">
          <Setter Property="Margin" Value="{TemplateBinding FrameThickness}" />
        </Style>

        <Style Selector="^:maximized /template/ PathIcon#MaximizeIcon">
          <Setter Property="Data" Value="{DynamicResource Icon.Restore}" />
        </Style>
        <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
          <Setter Property="IsVisible" Value="False" />
        </Style>
      </ControlTheme>

      <!-- A text button. The class "accent" marks the primary action. -->
      <ControlTheme x:Key="TextButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource KeyFaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KeyLipBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FocusAdorner">
          <FocusAdornerTemplate>
            <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="12" Margin="-2" AdornerLayer.IsClipEnabled="False" />
          </FocusAdornerTemplate>
        </Setter>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Panel>
              <Border Name="Lip" Background="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}" Margin="0,2,0,0" />
              <Border Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                      Padding="{TemplateBinding Padding}" Margin="0,0,0,2">
                <Border.Transitions>
                  <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
                  </Transitions>
                </Border.Transitions>
                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource KeyFaceHoverBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Face">
          <Setter Property="RenderTransform" Value="translateY(2px)" />
        </Style>
        <Style Selector="^.accent">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentLipBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="^.accent:pointerover">
          <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="^.danger, ^.danger:pointerover, ^.danger:pressed">
          <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DangerLipBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style Selector="^.danger:pointerover">
          <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </ControlTheme>

      <!-- Text that navigates, underlined on hover. -->
      <ControlTheme x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FocusAdorner">
          <FocusAdornerTemplate>
            <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="4" Margin="-4,-2" AdornerLayer.IsClipEnabled="False" />
          </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Background="Transparent" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter TextBlock">
          <Setter Property="TextDecorations" Value="Underline" />
        </Style>
      </ControlTheme>

      <!-- A sidebar entry, highlighted when it is the current section. -->
      <ControlTheme x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FocusAdorner">
          <FocusAdornerTemplate>
            <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="12" Margin="-2" AdornerLayer.IsClipEnabled="False" />
          </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
      </ControlTheme>

      <!-- A filter or tab chip. -->
      <ControlTheme x:Key="ChipButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FocusAdorner">
          <FocusAdornerTemplate>
            <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="12" Margin="-2" AdornerLayer.IsClipEnabled="False" />
          </FocusAdornerTemplate>
        </Setter>
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
      </ControlTheme>

      <!-- A switch with a rounded-square track and knob. -->
      <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusAdorner">
          <FocusAdornerTemplate>
            <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="9" Margin="-2" AdornerLayer.IsClipEnabled="False" />
          </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
              <ContentPresenter Name="Label" Content="{TemplateBinding OffContent}" VerticalAlignment="Center"
                                IsVisible="{Binding $parent[ToggleSwitch].OffContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Border Name="Track" Width="32" Height="18" CornerRadius="6" Background="{DynamicResource RaisedBrush}"
                      BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" VerticalAlignment="Center">
                <Canvas Name="PART_SwitchKnob" Width="12" Height="12" Margin="2,0" HorizontalAlignment="Left">
                  <Panel Name="PART_MovingKnobs" Width="12" Height="12" Canvas.Left="0">
                    <Panel.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Canvas.Left" Duration="0:0:0.12" Easing="CubicEaseOut" />
                      </Transitions>
                    </Panel.Transitions>
                    <Border Name="Knob" CornerRadius="4" Background="{DynamicResource TextTertiaryBrush}" />
                  </Panel>
                </Canvas>
              </Border>
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Knob">
          <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Track">
          <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Knob">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Keyboard focus rings. -->
  <Style Selector="AdornerLayer">
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="8" Margin="-2" AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- Tooltips open above their button. A tooltip under the pointer takes the pointer from the button. -->
  <Style Selector=":is(Button)">
    <Setter Property="ToolTip.Placement" Value="Top" />
    <Setter Property="ToolTip.VerticalOffset" Value="-6" />
  </Style>

  <!-- Names each button for screen readers after its tooltip, unless the button sets a name itself. -->
  <Style Selector=":is(Button)">
    <Setter Property="AutomationProperties.Name" Value="{Binding $self.(ToolTip.Tip)}" />
  </Style>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Typography. -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="42" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="-0.8" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- Times, counts and other figures. -->
  <Style Selector="TextBlock.num">
    <Setter Property="FontFamily" Value="{DynamicResource NumberFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <!-- The kind of thing a page shows, above its title. -->
  <Style Selector="TextBlock.kind">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <!-- The icon of the selected sidebar item. -->
  <Style Selector="RadioButton.nav:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- Small labels for sections and columns. -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <!-- Text fields. -->
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{DynamicResource FillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Rows in lists of tracks and queue entries. -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- A list inside a scrolling page, without a scroll viewer of its own. -->
  <Style Selector="ListBox.inline">
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <!-- The focus ring sits inside the row. -->
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRingBrush}" CornerRadius="10" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.rows ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
  </Style>
  <!-- The queue's rows draw their own highlight, below the autoplay divider. -->
  <Style Selector="ListBox.rows.queue ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.rows.queue ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.rows.queue ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.rows.queue ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.rows.queue ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Drop-downs, shaped like the text fields. -->
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="38" />
  </Style>

  <!-- Rows being dragged, the drop marker, and a playlist that would take the songs. -->
  <Style Selector="ListBox.rows ListBoxItem.dragging">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Border.drop-marker">
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem.drop /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DropTargetBrush}" />
  </Style>

  <!-- Genre and decade tiles. -->
  <Style Selector="Button.tile">
    <Setter Property="Margin" Value="0,0,14,14" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource OnTintPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.tile:pointerover">
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <!-- Compact song tiles. -->
  <Style Selector="Border.pick:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- Menus. -->
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="MenuItem PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Icons, drawn on their 24×24 design grid and scaled as a whole. -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
          <Canvas Width="24" Height="24">
            <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="PathIcon.small">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="PathIcon.large">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>
</Styles>
